#!/usr/bin/env bash
set -e

# Ensure we run tests from the repository root (modules and paths resolve correctly)
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "Running unit tests before push... (from $repo_root)"
if ! go test ./test/unit -v; then
  echo "Unit tests failed. Push aborted."
  exit 1
fi
echo "Unit tests passed. Proceeding with push."
exit 0